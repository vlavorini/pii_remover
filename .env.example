# ══════════════════════════════════════════════════════════════════════
# PII Remover - environment. Copy to .env and fill in your values.
# Every LLM call is OpenAI-compatible; point it at any provider.
# ══════════════════════════════════════════════════════════════════════

# ── OpenAI-compatible endpoint ────────────────────────────────────────
# Base URL must include the /v1 style path your provider expects.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Model used to transcribe PDFs/images (must accept image input)
VISION_MODEL=gpt-4o
# Model used by detector / critic / masker / describer agents
TEXT_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ── Agentic loop ──────────────────────────────────────────────────────
MAX_CRITIC_ROUNDS=3
AGREEMENT_THRESHOLD=0.9
AGENT_TEMPERATURE=0.0
# label -> [PERSON_4A91C2] | redact -> [REDACTED] | hash -> PERSON_4A91C2
MASK_STYLE=label

# ── Ingestion ─────────────────────────────────────────────────────────
# vision_first (recommended) | text_first
INGEST_STRATEGY=vision_first
INGEST_MAX_PAGES=15
INGEST_RENDER_DPI=150
INGEST_MAX_IMAGE_EDGE=1800
INGEST_JPEG_QUALITY=85
MAX_UPLOAD_MB=25

# ── Privacy ───────────────────────────────────────────────────────────
# REQUIRED when ENCRYPT_ARTIFACTS=true.
# Generate: python -m app.core.crypto
ENCRYPTION_KEY=
ENCRYPT_ARTIFACTS=true
# secret used to derive stable, non-reversible pseudonyms; change per deployment
PSEUDONYM_SALT=change-me-per-deployment
RETENTION_MINUTES=60
# set true in production (behind Traefik the request arrives as http)
FORCE_HTTPS=false
TRUST_PROXY_HEADERS=true
HSTS_MAX_AGE=31536000

# ── App ───────────────────────────────────────────────────────────────
# empty locally; /pii_remover when deployed behind Traefik StripPrefix
ROOT_PATH=
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# true = never call a model (deterministic offline pipeline, for testing)
MOCK_MODE=false
